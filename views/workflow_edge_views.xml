<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flow_edge_form" model="ir.ui.view">
        <field name="name">baramej.flow.edge.form</field>
        <field name="model">baramej.flow.edge</field>
        <field name="arch" type="xml">
            <form string="Connection">
                <sheet>
                    <group>
                        <field name="workflow_id"/>
                        <field name="source_node_id" domain="[('workflow_id', '=', workflow_id)]"/>
                        <field name="condition_branch"/>
                        <field name="target_node_id" domain="[('workflow_id', '=', workflow_id)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flow_edge_list" model="ir.ui.view">
        <field name="name">baramej.flow.edge.list</field>
        <field name="model">baramej.flow.edge</field>
        <field name="arch" type="xml">
            <list>
                <field name="workflow_id"/>
                <field name="source_node_id"/>
                <field name="condition_branch"/>
                <field name="target_node_id"/>
            </list>
        </field>
    </record>

    <record id="action_flow_edge" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">baramej.flow.edge</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
