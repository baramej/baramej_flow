<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flow_execution_form" model="ir.ui.view">
        <field name="name">baramej.flow.execution.form</field>
        <field name="model">baramej.flow.execution</field>
        <field name="arch" type="xml">
            <form string="Workflow Execution" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="workflow_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="trigger_source" readonly="1"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'success'"
                                   decoration-danger="state == 'failed'"
                                   decoration-info="state == 'running'"/>
                        </group>
                        <group>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                            <field name="duration" readonly="1"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="state != 'failed'" readonly="1"/>
                    <notebook>
                        <page string="Execution Log" name="log">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="node_name"/>
                                    <field name="node_type"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'success'"
                                           decoration-danger="state == 'failed'"/>
                                    <field name="duration"/>
                                </list>
                            </field>
                        </page>
                        <page string="Initial Context" name="context">
                            <field name="context_json" widget="text" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flow_execution_list" model="ir.ui.view">
        <field name="name">baramej.flow.execution.list</field>
        <field name="model">baramej.flow.execution</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date"/>
                <field name="workflow_id"/>
                <field name="trigger_source"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'running'"/>
                <field name="duration"/>
            </list>
        </field>
    </record>

    <record id="action_flow_execution" model="ir.actions.act_window">
        <field name="name">Executions</field>
        <field name="res_model">baramej.flow.execution</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_flow_execution_log_form" model="ir.ui.view">
        <field name="name">baramej.flow.execution.log.form</field>
        <field name="model">baramej.flow.execution.log</field>
        <field name="arch" type="xml">
            <form string="Node Execution Log" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="node_name" readonly="1"/>
                            <field name="node_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="duration" readonly="1"/>
                        </group>
                    </group>
                    <field name="error_message" invisible="state != 'failed'" readonly="1"/>
                    <group string="Input">
                        <field name="input_json" widget="text" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Output">
                        <field name="output_json" widget="text" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
