<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Note: no inherit_id template adds an "E-Services" tile to portal.portal_my_home
         here — that mechanism (counters/_prepare_home_portal_values) shifts enough
         between Odoo versions that hand-writing it without being able to test it felt
         like the wrong kind of confident. /my/eservices works as a direct URL
         regardless; wiring a home-page tile in is a safe, contained follow-up once
         this is verified against your actual Odoo 19 portal templates. -->

    <template id="portal_my_eservices" name="My E-Services">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="container">
                <h3>My E-Services</h3>
                <t t-if="not tickets">
                    <p class="text-muted">You haven't submitted any e-service applications yet.</p>
                </t>
                <t t-else="">
                    <table class="table table-hover o_portal_my_doc_table">
                        <thead>
                            <tr class="active">
                                <th>Reference</th>
                                <th>Submitted</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="tickets" t-as="ticket">
                                <td>
                                    <a t-attf-href="/my/eservices/#{ticket.id}">
                                        <t t-esc="ticket.name"/>
                                    </a>
                                </td>
                                <td>
                                    <span t-field="ticket.create_date"/>
                                </td>
                                <td>
                                    <span t-attf-class="badge badge-pill #{ticket.state == 'rejected' and 'badge-danger' or ticket.state in ('approved', 'done') and 'badge-success' or 'badge-info'}">
                                        <t t-esc="ticket.state"/>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-if="pager">
                        <t t-call="portal.pager"/>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_eservice_detail" name="E-Service Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_back_in_edit_mode"/>
            <div class="container">
                <h3>
                    <t t-esc="ticket.name"/>
                    <span t-attf-class="badge badge-pill float-end #{ticket.state == 'rejected' and 'badge-danger' or ticket.state in ('approved', 'done') and 'badge-success' or 'badge-info'}">
                        <t t-esc="ticket.state"/>
                    </span>
                </h3>

                <t t-if="ticket.state == 'rejected'">
                    <div class="alert alert-danger" role="alert">
                        <strong>Rejected:</strong>
                        <span t-esc="ticket.rejection_reason"/>
                    </div>
                </t>

                                <t t-if="ticket.state == 'waiting_payment'">
                    <div class="alert alert-warning" role="alert">
                        <t t-if="payment_link_expired">
                            The payment link has expired. Please contact support to request a new one.
                        </t>
                        <t t-else="">
                            <t t-if="ticket.payment_link">
                                Payment is required to continue.
                                <a t-att-href="ticket.payment_link" target="_blank" class="btn btn-primary btn-sm ms-2">
                                    Pay Now
                                </a>
                            </t>
                            <t t-else="">
                                <strong>[Test Mode]</strong> Payment is required to continue. This is a
                                simulated payment step — no real charge will occur.
                                <form t-attf-action="/my/eservices/#{ticket.id}/confirm-payment-test" method="post" class="d-inline">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-primary btn-sm ms-2">
                                        Confirm Payment (Test)
                                    </button>
                                </form>
                            </t>
                        </t>
                    </div>
                </t>

                                <h5 class="mt-4">Submitted Information</h5>
                <table class="table table-sm">
                    <tbody>
                        <tr t-foreach="submitted_rows" t-as="row">
                            <th t-esc="row['label']"/>
                            <td>
                                <t t-if="row['is_file']">
                                    <a t-attf-href="/web/content/#{row['attachment_id']}?download=true" target="_blank">
                                        <t t-esc="row['filename']"/> &#8595;
                                    </a>
                                </t>
                                <t t-else="">
                                    <t t-esc="row['value']"/>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <t t-if="ticket.state == 'waiting_info'">
                    <div class="alert alert-info mt-4" role="alert">
                        More information has been requested — see the message thread below. Use the form
                        below to respond and resubmit.
                    </div>
                    <t t-if="resubmit_error">
                        <div class="alert alert-danger" role="alert"><t t-esc="resubmit_error"/></div>
                    </t>
                    <form t-attf-action="/my/eservices/#{ticket.id}/resubmit" method="post"
                          enctype="multipart/form-data" class="mt-3">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <t t-if="request_lines">
                            <t t-foreach="request_lines" t-as="line" t-key="line.id">
                                <div class="mb-3">
                                    <label class="form-label">
                                        <t t-esc="line.label"/>
                                        <span t-if="line.required" style="color:#b3261e;"> *</span>
                                    </label>

                                    <t t-if="line.field_type == 'text'">
                                        <textarea t-att-name="line.name" class="form-control" rows="3"/>
                                    </t>
                                    <t t-elif="line.field_type == 'boolean'">
                                        <input type="checkbox" t-att-name="line.name" value="1"/>
                                    </t>
                                    <t t-elif="line.field_type == 'selection'">
                                        <select t-att-name="line.name" class="form-control">
                                            <option value="">-- Select --</option>
                                            <t t-foreach="(line.selection_options or '').split(',')" t-as="opt" t-key="opt">
                                                <option t-att-value="opt.strip()" t-esc="opt.strip()"/>
                                            </t>
                                        </select>
                                    </t>
                                    <t t-elif="line.field_type == 'file'">
                                        <input type="file" t-att-name="line.name" class="form-control"/>
                                    </t>
                                    <t t-else="">
                                        <t t-set="html_input_type"
                                           t-value="{'email': 'email', 'integer': 'number', 'float': 'number', 'date': 'date', 'datetime': 'datetime-local'}.get(line.field_type, 'text')"/>
                                        <input t-att-type="html_input_type" t-att-name="line.name" class="form-control"/>
                                    </t>
                                </div>
                            </t>
                        </t>

                        <div class="mb-3">
                            <label class="form-label">Your response / notes</label>
                            <textarea name="resubmit_message" class="form-control" rows="3"/>
                        </div>
                        <button type="submit" class="btn btn-primary">Resubmit</button>
                    </form>
                </t>

                <t t-if="ticket.state == 'waiting_info'">
                    <div class="alert alert-info mt-4" role="alert">
                        More information has been requested — see the message thread below. Use the form
                        below to respond and resubmit.
                    </div>
                    <form t-attf-action="/my/eservices/#{ticket.id}/resubmit" method="post" class="mt-3">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label class="form-label">Your response</label>
                            <textarea name="resubmit_message" class="form-control" rows="4"/>
                        </div>
                        <button type="submit" class="btn btn-primary">Resubmit</button>
                    </form>
                </t>

                                <h5 class="mt-4">Messages</h5>
                <div class="o_flow_message_list">
                    <t t-if="not messages">
                        <p class="text-muted">No messages yet.</p>
                    </t>
                    <t t-foreach="messages" t-as="msg" t-key="msg.id">
                        <div class="border rounded p-2 mb-2">
                            <div class="d-flex justify-content-between">
                                <strong t-esc="msg.author_id.name or msg.email_from or 'System'"/>
                                <small class="text-muted"><span t-field="msg.date"/></small>
                            </div>
                            <div t-out="msg.body"/>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

</odoo>
