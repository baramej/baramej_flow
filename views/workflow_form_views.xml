<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flow_form_form" model="ir.ui.view">
        <field name="name">baramej.flow.form.form</field>
        <field name="model">baramej.flow.form</field>
        <field name="arch" type="xml">
            <form string="Web Form">
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="oe_highlight" invisible="is_published == True"
                            groups="baramej_flow.group_flow_manager"/>
                    <button name="action_unpublish" string="Unpublish" type="object"
                            invisible="is_published == False"
                            groups="baramej_flow.group_flow_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_submissions" type="object" class="oe_stat_button" icon="fa-inbox">
                            <field name="submission_count" widget="statinfo" string="Submissions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Ticket Intake Form"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workflow_id"/>
                            <field name="is_published" readonly="1"/>
                        </group>
                        <group>
                            <field name="public_url" readonly="1" invisible="not public_url"/>
                        </group>
                    </group>
                    <group string="Public-Facing Text">
                        <field name="description" placeholder="Shown above the form fields..."/>
                        <field name="submit_button_label"/>
                        <field name="thank_you_message"/>
                    </group>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="name"/>
                                    <field name="field_type"/>
                                    <field name="selection_options" invisible="field_type != 'selection'"/>
                                    <field name="required"/>
                                    <field name="placeholder" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flow_form_list" model="ir.ui.view">
        <field name="name">baramej.flow.form.list</field>
        <field name="model">baramej.flow.form</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="workflow_id"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="submission_count"/>
            </list>
        </field>
    </record>

    <record id="action_flow_form" model="ir.actions.act_window">
        <field name="name">Web Forms</field>
        <field name="res_model">baramej.flow.form</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first form</p>
            <p>
                A form must be linked to a workflow whose Trigger Type is "Web Form". Add fields,
                publish the form, then share its Public URL — submissions run the linked workflow
                with each field's value available as {{form.&lt;field name&gt;}}.
            </p>
        </field>
    </record>

</odoo>
