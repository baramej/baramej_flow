    <record id="action_flow_workflow" model="ir.actions.act_window">
        <field name="name">Workflows</field>
        <field name="res_model">baramej.flow.workflow</field>
        <field name="view_mode">list,form</field>
<!--        <field name="search_view_id" ref="view_flow_workflow_search"/>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first workflow
            </p>
            <p>
                A workflow starts with a Trigger node and flows through Action and Condition
                nodes. Add nodes on the Nodes tab, wire them together on the Connections tab,
                then use "Run Test" to validate it end-to-end.
            </p>
        </field>
