<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flow_node_form" model="ir.ui.view">
        <field name="name">baramej.flow.node.form</field>
        <field name="model">baramej.flow.node</field>
        <field name="arch" type="xml">
            <form string="Workflow Node">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workflow_id"/>
                            <field name="node_type"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Canvas Position">
                            <field name="pos_x"/>
                            <field name="pos_y"/>
                        </group>
                    </group>
                    <group string="Configuration">
                        <field name="config_json" widget="text" nolabel="1"
                               placeholder='{"model": "res.partner", "values": {"name": "{{form.name}}"}, "output_key": "record_id"}'/>
                    </group>
                    <field name="note" placeholder="Notes for whoever maintains this workflow next..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flow_node_list" model="ir.ui.view">
        <field name="name">baramej.flow.node.list</field>
        <field name="model">baramej.flow.node</field>
        <field name="arch" type="xml">
            <list>
                <field name="workflow_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="node_type"/>
            </list>
        </field>
    </record>

    <record id="action_flow_node" model="ir.actions.act_window">
        <field name="name">Nodes</field>
        <field name="res_model">baramej.flow.node</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
