<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flow_credential_form" model="ir.ui.view">
        <field name="name">baramej.flow.credential.form</field>
        <field name="model">baramej.flow.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object"
                            class="btn-secondary"
                            invisible="not api_key and not db_host and not oauth_refresh_token"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="provider"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>

                    <group string="API Key" invisible="provider not in ('openai', 'gemini', 'whatsapp', 'generic')">
                        <field name="api_key" password="True"/>
                        <div class="text-muted" colspan="2" invisible="provider != 'generic'">
                            For HTTP Request nodes using Basic auth, store "username:password" here.
                        </div>
                    </group>

                    <group string="Database Connection" invisible="provider not in ('postgres', 'supabase')">
                        <field name="db_host" placeholder="db.xxxxx.supabase.co"/>
                        <field name="db_port"/>
                        <field name="db_name" placeholder="postgres"/>
                        <field name="db_user" placeholder="postgres"/>
                        <field name="db_password" password="True"/>
                        <field name="db_sslmode"/>
                    </group>

                    <group string="Google OAuth2" invisible="provider != 'google_oauth2'">
                        <field name="oauth_client_id"/>
                        <field name="oauth_client_secret" password="True"/>
                        <field name="oauth_refresh_token" password="True"/>
                        <field name="oauth_token_uri"/>
                        <field name="oauth_access_token" readonly="1" invisible="not oauth_access_token"/>
                        <field name="oauth_token_expiry" readonly="1" invisible="not oauth_token_expiry"/>
                        <div class="text-muted" colspan="2">
                            The Refresh Token must be obtained externally (e.g. via Google's OAuth Playground)
                            with the scopes your workflows need (Sheets/Gmail/Calendar/Drive). This module
                            renews the short-lived Access Token automatically from it on every use.
                        </div>
                    </group>

                    <field name="note" placeholder="Where this key came from, rotation date, etc."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_flow_credential_list" model="ir.ui.view">
        <field name="name">baramej.flow.credential.list</field>
        <field name="model">baramej.flow.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_flow_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">baramej.flow.credential</field>
        <field name="view_mode">list,form</field>
<!--        <field name="groups_id" eval="[(4, ref('group_flow_manager'))]"/>-->
    </record>

</odoo>
