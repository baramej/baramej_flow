<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_flow_ticket_kanban" model="ir.ui.view">
        <field name="name">baramej.flow.ticket.kanban</field>
        <field name="model">baramej.flow.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="partner_id"/>
                                </div>
                                <div class="text-muted">
                                    <field name="create_date" widget="date"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_flow_ticket_form" model="ir.ui.view">
        <field name="name">baramej.flow.ticket.form</field>
        <field name="model">baramej.flow.ticket</field>
        <field name="arch" type="xml">
            <form string="E-Service Ticket">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary"
                            invisible="state not in ('submitted', 'in_review') or current_approve_mode != 'approve'"/>
                    <button name="action_approve" string="Send for Approval" type="object"
                            class="btn-primary"
                            invisible="state not in ('submitted', 'in_review') or current_approve_mode != 'forward'"/>
                    <button name="action_open_reject_wizard" string="Reject" type="object"
                            class="btn-secondary" invisible="state not in ('submitted', 'in_review')"/>
                    <button name="action_open_request_info_wizard" string="Request More Info" type="object"
                            class="btn-secondary"
                            invisible="state not in ('submitted', 'in_review') or current_approve_mode != 'forward'"/>
                    <button name="action_open_request_info_from_reviewer_wizard" string="Request Info from Reviewer"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('submitted', 'in_review') or current_approve_mode != 'approve'"/>
                    <button name="action_send_payment_link_manual" string="Send Payment Link" type="object"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="submitted,in_review,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(baramej_flow.action_flow_execution)d" type="action"
                                class="oe_stat_button" icon="fa-history"
                                context="{'search_default_workflow_id': workflow_id}"
                                invisible="not execution_id">
                            <span>Execution</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="user_id"/>
                            <field name="current_approver_id" readonly="1" invisible="not current_approver_id"/>
                            <field name="form_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="workflow_id" readonly="1"/>
                            <field name="payment_link" readonly="1" invisible="not payment_link" widget="url"/>
                        </group>
                    </group>
                    <field name="rejection_reason" invisible="state != 'rejected'" readonly="1"/>
                    <notebook>
                        <page string="Submitted Data" name="submitted_data">
                            <field name="submitted_data_html" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Pending Info Requests" name="info_requests"
                              invisible="not info_request_line_ids">
                            <field name="info_request_line_ids" readonly="1">
                                <list>
                                    <field name="label"/>
                                    <field name="name"/>
                                    <field name="field_type"/>
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_flow_ticket_list" model="ir.ui.view">
        <field name="name">baramej.flow.ticket.list</field>
        <field name="model">baramej.flow.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="workflow_id"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'rejected'"
                       decoration-success="state in ('approved', 'done')"
                       decoration-info="state in ('waiting_info', 'waiting_payment')"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_flow_ticket" model="ir.actions.act_window">
        <field name="name">E-Service Tickets</field>
        <field name="res_model">baramej.flow.ticket</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Reject wizard -->
    <record id="view_flow_ticket_reject_wizard_form" model="ir.ui.view">
        <field name="name">baramej.flow.ticket.reject.wizard.form</field>
        <field name="model">baramej.flow.ticket.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Application">
                <field name="ticket_id" invisible="1"/>
                <group>
                    <field name="reason" nolabel="1"
                           placeholder="Explain why this application is being rejected — shown to the applicant."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Request info wizard -->
    <!-- Request info wizard -->
    <record id="view_flow_ticket_request_info_wizard_form" model="ir.ui.view">
        <field name="name">baramej.flow.ticket.request.info.wizard.form</field>
        <field name="model">baramej.flow.ticket.request.info.wizard</field>
        <field name="arch" type="xml">
            <form string="Request More Information">
                <field name="ticket_id" invisible="1"/>
                <field name="form_id" invisible="1"/>
                <group>
                    <field name="message" nolabel="1"
                           placeholder="Explain what's missing or needed — shown to the applicant."/>
                </group>
                <group string="Specific Fields (optional)">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="mode"/>
                            <field name="existing_field_id" invisible="mode != 'update'" options="{'no_create': True}"/>
                            <field name="name" invisible="mode != 'new'"/>
                            <field name="label"/>
                            <field name="field_type" invisible="mode != 'new'"/>
                            <field name="selection_options" invisible="field_type != 'selection' or mode != 'new'"/>
                            <field name="required"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_confirm" string="Send Request" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Request info from reviewer wizard (internal-only, no customer visibility) -->
    <record id="view_flow_ticket_request_info_from_reviewer_wizard_form" model="ir.ui.view">
        <field name="name">baramej.flow.ticket.request.info.from.reviewer.wizard.form</field>
        <field name="model">baramej.flow.ticket.request.info.from.reviewer.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Info from Reviewer">
                <field name="ticket_id" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    This is an internal note between staff — the applicant will never see it.
                </div>
                <group>
                    <field name="message" nolabel="1" placeholder="What do you need from the reviewer?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Send" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
